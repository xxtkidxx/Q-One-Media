# PROD — copy thành .env.prod rồi điền
# cp .env.prod.example .env.prod
#
# Khác dev ở bốn điểm: mật khẩu thật, port chỉ bind 127.0.0.1, log INFO,
# n8n có basic auth. Dữ liệu nằm ở data/prod/ — hoàn toàn tách khỏi data/dev/.

APP_ENV=prod
TZ=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO

# ---- Postgres ----
POSTGRES_USER=qone
POSTGRES_PASSWORD=DAT_MAT_KHAU_MANH_O_DAY
POSTGRES_DB=qone
# Không mở port postgres ra host ở prod

# ---- Port, chỉ bind 127.0.0.1 (khác dev để chạy song song được) ----
API_PORT=8001
N8N_PORT=5679

# ---- n8n ----
N8N_ENCRYPTION_KEY=KHOA_KHAC_VOI_DEV_32_BYTE_HEX
N8N_WEBHOOK_URL=https://n8n.noi-bo.nmi.vn/
N8N_USER=admin
N8N_PASSWORD=DAT_MAT_KHAU_MANH_O_DAY

# ---- GPU ----
GPU_COUNT=1
WORKER_CONCURRENCY=2

# ---- LLM ----
# Bat buoc cho HAI buoc: chon doan (G2.7) va viet kich ban (G2.8).
# Thieu key thi worker that bai ro rang o hai buoc do, cac buoc khac van chay.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
LLM_MODEL=gemini-3.5-flash-lite
LLM_MODEL_HARD=gemini-3.6-pro

# ---- TTS ----
TTS_ENGINE=voxcpm
VOXCPM_VOICE_REF=
# Loi doc cua chinh file audio mau o tren. Co thi clone giong kha hon ro ret.
VOXCPM_VOICE_REF_TEXT=/models/voices/nmi-engineer-ref.wav
FPTAI_API_KEY=
# Toc do doc DO DUOC cua giong dang dung, am tiet/giay (G0.7).
# De trong cho toi khi do that: chua do thi pipeline TU CHOI lap ngan sach am tiet
# chu khong lay con so tren mang ra dung.
TTS_SYLLABLES_PER_SEC=

# ---- Publish ----
YOUTUBE_CLIENT_SECRET_FILE=/data/secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=/data/secrets/youtube_token.json
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# ---- Kill-switch publish ----
# License gate va gate duyet cua nguoi KHONG co cong tat: chung la bat bien cua
# tang domain (src/domain/sourcing/clearance.py). Mot co co the dat false chinh
# la duong tat ma quy tac nghiep vu cam. PUBLISH_ENABLED thi giu, vi no chi chan
# them chu khong bao gio mo them.
# Bật publish chỉ khi đã có license và đã duyệt quy trình
PUBLISH_ENABLED=false

# ---- Mat tien web noi bo ----
# BAT BUOC o prod: trang nay cho duyet va publish noi dung.
WEB_USER=
WEB_PASSWORD=
WEB_SESSION_SECRET=replace-with-at-least-32-random-characters

# --- TikTok (G7.1) ---
# Client chua qua audit cua TikTok CHI dang duoc o che do rieng tu; de nguyen
# SELF_ONLY cho toi khi audit xong, neu khong moi lan dang deu bi tu choi.
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# --- Sinh anh minh hoa cho Studio (Giai doan 2) — TUY CHON ---
# Chua cau hinh la binh thuong: canh AI se roi ve the thuong hieu, pipeline
# khong dung. AI chi dung cho anh boi canh; so lieu luon di qua canh bieu do.
IMAGE_PROVIDER=none
IMAGE_API_KEY=
IMAGE_MODEL=gemini-3-pro-image
