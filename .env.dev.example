# DEV — copy thành .env.dev rồi điền
# cp .env.dev.example .env.dev

APP_ENV=dev
TZ=Asia/Ho_Chi_Minh
LOG_LEVEL=DEBUG

# ---- Postgres ----
POSTGRES_USER=qone
POSTGRES_PASSWORD=doi_mat_khau_nay
POSTGRES_DB=qone
POSTGRES_PORT=55432

# ---- Port mở ra localhost (dev) ----
API_PORT=8008
N8N_PORT=5678

# ---- n8n ----
# Sinh khoá: openssl rand -hex 32
N8N_ENCRYPTION_KEY=thay_bang_32_byte_hex
N8N_WEBHOOK_URL=http://localhost:5678/

# ---- GPU ----
# GPU_COUNT=1 nếu có NVIDIA GPU (Windows: Docker Desktop + WSL2 + NVIDIA Container Toolkit).
# GPU_COUNT=0 để chạy CPU — được, nhưng WhisperX large-v3 sẽ rất chậm.
GPU_COUNT=1
WORKER_CONCURRENCY=1

# ---- LLM ----
# Gemini co free tier; doi thanh anthropic va dien ANTHROPIC_API_KEY neu can.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_MODEL_HARD=gemini-3.6-pro

# ---- TTS ----
# voxcpm = local, Apache-2.0, mac dinh. fptai = du phong thuong mai.
# edge = CHI DEV: chay duoc toan chuoi khong can GPU, nhung dieu khoan thuong mai
#        khong ro rang nen bi CHAN o APP_ENV=prod. Giong: vi-VN-HoaiMyNeural (nu),
#        vi-VN-NamMinhNeural (nam) - dat vao VOXCPM_VOICE_REF khi dung engine nay.
TTS_ENGINE=voxcpm
VOXCPM_VOICE_REF=
# Loi doc cua chinh file audio mau o tren. Co thi clone giong kha hon ro ret.
VOXCPM_VOICE_REF_TEXT=/models/voices/nmi-engineer-ref.wav
FPTAI_API_KEY=
# Toc do doc DO DUOC cua giong dang dung, am tiet/giay (G0.7).
# De trong cho toi khi do that: chua do thi pipeline TU CHOI lap ngan sach am tiet
# chu khong lay con so tren mang ra dung.
# Do bang: make speech-rate. Da do 14/09/2026 voi edge-tts -> 3.54.
# LUU Y: cac nguon tren mang ghi 5,28-6 am tiet/giay. Lay 5,5 thi ngan sach
# rong hon thuc te ~56%% va MOI canh deu tran khung. Phai tu do.
TTS_SYLLABLES_PER_SEC=

# ---- Publish (điền khi tới G3/G4) ----
YOUTUBE_CLIENT_SECRET_FILE=
YOUTUBE_TOKEN_FILE=
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# ---- Kill-switch publish ----
# License gate va gate duyet cua nguoi KHONG co cong tat: chung la bat bien cua
# tang domain (src/domain/sourcing/clearance.py). Mot co co the dat false chinh
# la duong tat ma quy tac nghiep vu cam. PUBLISH_ENABLED thi giu, vi no chi chan
# them chu khong bao gio mo them.
PUBLISH_ENABLED=false

# ---- Mat tien web noi bo ----
# De trong o dev thi khong hoi mat khau (dev chi mo o localhost).
WEB_USER=
WEB_PASSWORD=
