# DEV — copy thành .env.dev rồi điền
# cp .env.dev.example .env.dev

APP_ENV=dev
TZ=Asia/Ho_Chi_Minh
LOG_LEVEL=DEBUG

# ---- Postgres ----
POSTGRES_USER=qone
POSTGRES_PASSWORD=doi_mat_khau_nay
POSTGRES_DB=qone
POSTGRES_PORT=55432

# ---- Port mở ra localhost (dev) ----
API_PORT=8000
N8N_PORT=5678

# ---- n8n ----
# Sinh khoá: openssl rand -hex 32
N8N_ENCRYPTION_KEY=thay_bang_32_byte_hex
N8N_WEBHOOK_URL=http://localhost:5678/

# ---- GPU ----
# GPU_COUNT=1 nếu có NVIDIA GPU (Windows: Docker Desktop + WSL2 + NVIDIA Container Toolkit).
# GPU_COUNT=0 để chạy CPU — được, nhưng WhisperX large-v3 sẽ rất chậm.
GPU_COUNT=1
WORKER_CONCURRENCY=1

# ---- LLM ----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MODEL_HARD=claude-opus-5

# ---- TTS ----
# voxcpm = local, Apache-2.0, mặc định. fptai = dự phòng qua cùng interface.
TTS_ENGINE=voxcpm
VOXCPM_VOICE_REF=/models/voices/nmi-engineer-ref.wav
FPTAI_API_KEY=
# Toc do doc DO DUOC cua giong dang dung, am tiet/giay (G0.7).
# De trong cho toi khi do that: chua do thi pipeline TU CHOI lap ngan sach am tiet
# chu khong lay con so tren mang ra dung.
TTS_SYLLABLES_PER_SEC=

# ---- Publish (điền khi tới G3/G4) ----
YOUTUBE_CLIENT_SECRET_FILE=
YOUTUBE_TOKEN_FILE=
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# ---- Kill-switch publish ----
# License gate va gate duyet cua nguoi KHONG co cong tat: chung la bat bien cua
# tang domain (src/domain/sourcing/clearance.py). Mot co co the dat false chinh
# la duong tat ma quy tac nghiep vu cam. PUBLISH_ENABLED thi giu, vi no chi chan
# them chu khong bao gio mo them.
PUBLISH_ENABLED=false
